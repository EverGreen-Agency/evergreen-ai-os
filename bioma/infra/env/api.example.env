APP_ENV=local
API_NAME=Bioma API
DATABASE_URL=postgresql://bioma:bioma@localhost:5433/bioma
SESSION_COOKIE_NAME=bioma_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
ALLOW_DEV_SEED=false
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=
CLICKUP_API_TOKEN=
CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2
CLICKUP_TASK_PAGE_LIMIT=3
CLICKUP_WEBHOOK_SECRET=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://www.evergreenmkt.com.br,https://evergreenmkt.com.br
LOG_LEVEL=debug
# OAuth Google (AUTH-003): credenciais do Google Cloud Console (tipo Web).
# redirect_uri autorizado = {API_PUBLIC_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
API_PUBLIC_URL=http://127.0.0.1:8000
WEB_APP_URL=http://localhost:5173
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT_URL=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_FORCE_PATH_STYLE=true
STORAGE_MAX_UPLOAD_MB=20
# Cifra de segredos de integração em repouso (Kommo etc.). Gere com:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_ENCRYPTION_KEY=
# Necessário só para renovar tokens Kommo expirados (mesmo redirect da integração)
KOMMO_REDIRECT_URI=
