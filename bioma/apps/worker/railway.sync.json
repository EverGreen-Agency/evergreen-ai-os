{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "python -m bioma_worker.cli --enqueue-all --drain --days 3",
    "cronSchedule": "0 */6 * * *",
    "restartPolicyType": "NEVER"
  }
}
