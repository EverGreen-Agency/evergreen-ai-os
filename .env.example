# ==========================================
# EVERGREEN AI OS - VARIÁVEIS GLOBAIS
# ==========================================
# Crie uma cópia deste arquivo como ".env" 
# e preencha com suas chaves reais.
# NUNCA comite o arquivo ".env" real no GitHub!

# --- Modelos de IA (Cérebros) ---
OPENAI_API_KEY=sk-proj-xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx
GEMINI_API_KEY=xxxx

# --- Orquestração e Infra ---
# n8n ou similares (se auto-hospedado)
N8N_WEBHOOK_URL=https://n8n.sua-agencia.com/webhook

# --- Integrações Globais da EverGreen ---
# Chaves de sistemas que são centralizados na agência (Ex: ClickUp da EG)
CLICKUP_API_KEY=pk_xxxx
CLICKUP_WORKSPACE_ID=1234567

# ==========================================
# ATENÇÃO SOBRE CHAVES DE CLIENTES
# ==========================================
# Tokens de Kommo, Meta Ads, etc. de CLIENTES específicos
# NÃO devem ser colocados aqui. Eles devem ser mantidos
# nos arquivos JSON isolados dentro de:
# _opensquad/_memory/clients/<id_do_cliente>/
